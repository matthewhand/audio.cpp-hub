{
  "name": "audio-cpp-hub-web",
  "version": "0.0.0",
  "private": true,
  "description": "audio.cpp-hub 前端开发期工具链（仅开发/CI 使用，运行期零构建）",
  "type": "module",
  "scripts": {
    "check:types": "tsc -p tsconfig.json",
    "lint": "eslint web",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run check:types && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
