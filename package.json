{
  "name": "audio.cpp-hub",
  "version": "0.0.0",
  "private": true,
  "description": "audio.cpp-hub 前端开发工具链：lint / 格式化 / 类型检查（棘轮）与 Playwright e2e、node:test 单元测试、UI 清单、性能预算。均仅开发 / CI 使用，发布二进制不含，运行时不需要 Node。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/web-quality/tsc-ratchet.mjs",
    "test:unit": "node --test \"test/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test --config e2e/playwright.config.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "ui:inventory": "node scripts/ui-inventory.mjs",
    "ui:inventory:check": "node scripts/ui-inventory-check.mjs",
    "perf:budget": "node scripts/perf-budget.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
